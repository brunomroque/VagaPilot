# Empty on purpose. The PDF names the services; these identifiers are the ones the app will read.
# Do not put real secrets in this file.

# Supabase (sa-east-1). Public values are safe to expose to the browser; service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: newer projects expose a publishable key instead of the anon key; the app accepts either.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Local Supabase Google provider (supabase/config.toml, enable it there). Scopes requested: openid email profile.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Dev-only fake session for UI work and the Playwright shell smoke (GET /dev/entrar).
# Ignored when NODE_ENV=production. Never set in deployed environments.
VAGAPILOT_DEV_AUTH_BYPASS=
# Dev/e2e only: job links are read from FICTITIOUS recorded fixtures (packages/ats-adapters/fixtures)
# instead of the network. Ignored when NODE_ENV=production.
VAGAPILOT_ATS_FIXTURES=
# Tests: make RLS tests fail instead of skip when the local stack is missing (set in CI).
VAGAPILOT_REQUIRE_SUPABASE=

# Google Cloud OAuth. Login uses openid email profile. Gmail uses incremental gmail.readonly and gmail.send.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=
# Defaults to {app origin}/api/google/oauth/callback. Register it in the Google Cloud OAuth client.
GOOGLE_GMAIL_REDIRECT_URI=
# Dev/test only: fixture Gmail backend and fake consent instead of Google (ignored in production).
VAGAPILOT_GMAIL_MOCK=

# LLM gateway (Vercel AI Gateway or OpenRouter).
# Large model: fit, drafts, chat orchestrator. Small model: extraction and email classification.
# Defaults (when empty): google/gemini-2.5-pro and google/gemini-2.5-flash.
# Spend Gemini credits by adding the Google key as BYOK on the gateway, then set AI_GATEWAY_API_KEY
# and leave AI_PROVIDER unset (or anything other than fake).
# Embeddings: google/gemini-embedding-001 asked for 1536 (database vector width).
# The model defaults to 3072; packages/ai requests outputDimensionality 1536 and L2-normalizes.
# Do not mix vectors from another embedding model in the same columns.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
LLM_MODEL_LARGE=google/gemini-2.5-pro
LLM_MODEL_SMALL=google/gemini-2.5-flash
EMBEDDING_MODEL=google/gemini-embedding-001

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resend (transactional email: reminders and account mail, not the user's Gmail).
# Without RESEND_API_KEY reminders are only logged (dev); the in-app bell still works.
# Setup (VagaPilot-only API key, verified FROM): docs/CONFIG_STRIPE_RESEND.md
RESEND_API_KEY=
EMAIL_FROM=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Langfuse (LLM traces; redact PII before export)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# PostHog (product analytics, no PII)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Upstash Ratelimit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenTelemetry (optional; OTLP HTTP exporter)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vagapilot-web

# Envelope encryption (spec 12.3). KEY_PROVIDER is local in dev (LocalKeyProvider) or aws/gcp later.
# KEK_LOCAL is the dev key-encryption key. Do not commit real key material.
KEY_PROVIDER=
KEK_LOCAL=
AWS_REGION=
AWS_KMS_KEY_ID=
GCP_KMS_KEY_RESOURCE=

# Stripe (BRL). Test products/prices and price IDs: docs/CONFIG_STRIPE_RESEND.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_EXECUTIVE_MONTHLY=
STRIPE_PRICE_EXECUTIVE_YEARLY=
STRIPE_PRICE_SEARCH_PASS=

# App
NEXT_PUBLIC_APP_URL=

# Cloud browser pool + cloud apply (server only). The DB stores only these variable NAMES
# (browser_providers.secret_env_var / project_env_var); manage providers at /app/admin.
BROWSER_POOL_ENABLED=false
BROWSERLESS_API_TOKEN=
STEEL_API_KEY=
KERNEL_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
HYPERBROWSER_API_KEY=
# Shared secret between the app and the Netlify background function apply-runner-background.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPLY_RUNNER_SECRET=
# LinkedIn Easy Apply automation violates LinkedIn's User Agreement and can get the account
# restricted. Keep false unless you accept that risk.
APPLY_LINKEDIN_ENABLED=false
