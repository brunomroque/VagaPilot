{
  "name": "vagapilot",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "eval:fit": "pnpm --filter @vagapilot/ai eval:fit",
    "eval:no-fabrication": "pnpm --filter @vagapilot/ai eval:no-fabrication",
    "evals": "pnpm --filter @vagapilot/ai evals",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "eval:email": "pnpm --filter @vagapilot/gmail eval:email",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vagapilot/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write"
  }
}
